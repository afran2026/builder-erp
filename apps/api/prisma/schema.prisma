enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

enum AccountNormalBalance {
  DEBIT
  CREDIT
}

enum AccountingPeriodStatus {
  OPEN
  CLOSED
  LOCKED
}

enum JournalEntryStatus {
  DRAFT
  APPROVED
  POSTED
  REVERSED
}

enum JournalSourceType {
  MANUAL
  CUSTOMER_PAYMENT
  SALES_BOOKING
  VENDOR_PAYMENT
  PROCUREMENT
  PAYROLL
  INVESTOR_CONTRIBUTION
  PROFIT_DISTRIBUTION
  INVESTOR_WITHDRAWAL
  EXPENSE
  RECEIPT
  BANK_TRANSACTION
  STOCK_MOVEMENT
  LAND_ACQUISITION
  OPENING_BALANCE
}

enum BankTransactionType {
  DEPOSIT
  WITHDRAWAL
}

enum BankTransactionStatus {
  UNMATCHED
  MATCHED
  RECONCILED
  VOIDED
}

enum BankReconciliationStatus {
  DRAFT
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum FinancialRecordStatus {
  DRAFT
  PENDING
  APPROVED
  POSTED
  CANCELLED
}

model ChartOfAccount {
  id             String               @id @default(uuid()) @db.Uuid
  organizationId String               @db.Uuid
  parentId       String?              @db.Uuid
  code           String
  name           String
  nameBn         String?
  accountType    AccountType
  normalBalance  AccountNormalBalance
  isGroup        Boolean              @default(false)
  allowPosting   Boolean              @default(true)
  isActive       Boolean              @default(true)
  description    String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent       ChartOfAccount?  @relation("AccountHierarchy", fields: [parentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  children     ChartOfAccount[] @relation("AccountHierarchy")

  journalLines JournalLine[]
  bankAccounts BankAccount[]
  expenses     Expense[]           @relation("ExpenseAccount")
  receipts     Receipt[]           @relation("ReceiptAccount")
  budgetLines  ProjectBudgetLine[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, accountType, isActive])
  @@index([parentId])
  @@map("chart_of_accounts")
}

model AccountingPeriod {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @db.Uuid
  financialYearId String                 @db.Uuid
  name            String
  startDate       DateTime               @db.Date
  endDate         DateTime               @db.Date
  status          AccountingPeriodStatus @default(OPEN)
  closedAt        DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  financialYear  FinancialYear  @relation(fields: [financialYearId, organizationId], references: [id, organizationId], onDelete: Restrict)
  journalEntries JournalEntry[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([financialYearId, status])
  @@map("accounting_periods")
}

model JournalEntry {
  id                 String             @id @default(uuid()) @db.Uuid
  organizationId     String             @db.Uuid
  accountingPeriodId String             @db.Uuid
  entryNo            String
  entryDate          DateTime           @db.Date
  description        String
  sourceType         JournalSourceType  @default(MANUAL)
  sourceReference    String?
  status             JournalEntryStatus @default(DRAFT)
  totalDebit         Decimal            @default(0) @db.Decimal(18, 2)
  totalCredit        Decimal            @default(0) @db.Decimal(18, 2)
  createdById        String             @db.Uuid
  approvedById       String?            @db.Uuid
  postedAt           DateTime?
  reversedAt         DateTime?
  reversalOfId       String?            @unique @db.Uuid
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  accountingPeriod AccountingPeriod @relation(fields: [accountingPeriodId, organizationId], references: [id, organizationId], onDelete: Restrict)
  createdBy        User             @relation("JournalCreator", fields: [createdById, organizationId], references: [id, organizationId], onDelete: Restrict)
  approvedBy       User?            @relation("JournalApprover", fields: [approvedById, organizationId], references: [id, organizationId], onDelete: Restrict)
  reversalOf       JournalEntry?    @relation("JournalReversal", fields: [reversalOfId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reversalEntries  JournalEntry[]   @relation("JournalReversal")
  lines            JournalLine[]

  @@unique([organizationId, entryNo])
  @@unique([id, organizationId])
  @@unique([organizationId, sourceType, sourceReference])
  @@index([organizationId, entryDate, status])
  @@index([accountingPeriodId, status])
  @@index([sourceType])
  @@map("journal_entries")
}

model JournalLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  journalEntryId String   @db.Uuid
  accountId      String   @db.Uuid
  projectId      String?  @db.Uuid
  costCenterId   String?  @db.Uuid
  bankAccountId  String?  @db.Uuid
  description    String?
  debit          Decimal  @default(0) @db.Decimal(18, 2)
  credit         Decimal  @default(0) @db.Decimal(18, 2)
  lineOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  journalEntry JournalEntry   @relation(fields: [journalEntryId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  costCenter   CostCenter?    @relation(fields: [costCenterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  bankAccount  BankAccount?   @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@index([accountId, journalEntryId])
  @@index([projectId, accountId])
  @@index([costCenterId])
  @@index([organizationId])
  @@map("journal_lines")
}

model CostCenter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  projectId      String?  @db.Uuid
  code           String
  name           String
  nameBn         String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?      @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  journalLines JournalLine[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([projectId, isActive])
  @@map("cost_centers")
}

model BankAccount {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  accountId      String   @db.Uuid
  bankName       String
  branchName     String?
  accountName    String
  accountNumber  String
  routingNumber  String?
  currency       String   @default("BDT")
  openingBalance Decimal  @default(0) @db.Decimal(18, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  account         ChartOfAccount       @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions    BankTransaction[]
  reconciliations BankReconciliation[]
  journalLines    JournalLine[]
  receipts        Receipt[]

  @@unique([organizationId, accountNumber])
  @@unique([id, organizationId])
  @@index([organizationId, isActive])
  @@map("bank_accounts")
}

model BankTransaction {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  bankAccountId    String                @db.Uuid
  transactionDate  DateTime              @db.Date
  transactionType  BankTransactionType
  amount           Decimal               @db.Decimal(18, 2)
  referenceNo      String?
  description      String?
  status           BankTransactionStatus @default(UNMATCHED)
  reconciliationId String?               @db.Uuid
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount    BankAccount         @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  reconciliation BankReconciliation? @relation(fields: [reconciliationId, bankAccountId, organizationId], references: [id, bankAccountId, organizationId], onDelete: Restrict)

  @@index([bankAccountId, transactionDate])
  @@index([organizationId])
  @@index([reconciliationId, status])
  @@map("bank_transactions")
}

model BankReconciliation {
  id               String                   @id @default(uuid()) @db.Uuid
  organizationId   String                   @db.Uuid
  bankAccountId    String                   @db.Uuid
  periodStart      DateTime                 @db.Date
  periodEnd        DateTime                 @db.Date
  statementBalance Decimal                  @db.Decimal(18, 2)
  bookBalance      Decimal                  @db.Decimal(18, 2)
  difference       Decimal                  @db.Decimal(18, 2)
  status           BankReconciliationStatus @default(DRAFT)
  recordedById     String                   @db.Uuid
  completedAt      DateTime?
  notes            String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  bankAccount  BankAccount       @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy   User              @relation("BankReconciliationRecorder", fields: [recordedById, organizationId], references: [id, organizationId], onDelete: Restrict)
  transactions BankTransaction[]

  @@unique([bankAccountId, periodStart, periodEnd])
  @@unique([id, bankAccountId])
  @@unique([id, bankAccountId, organizationId])
  @@index([status, periodEnd])
  @@index([organizationId])
  @@map("bank_reconciliations")
}

model Expense {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  projectId       String?               @db.Uuid
  accountId       String                @db.Uuid
  vendorId        String?               @db.Uuid
  expenseNo       String
  expenseDate     DateTime              @db.Date
  description     String
  amount          Decimal               @db.Decimal(18, 2)
  status          FinancialRecordStatus @default(DRAFT)
  sourceReference String?
  recordedById    String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account      ChartOfAccount @relation("ExpenseAccount", fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  vendor       Vendor?        @relation(fields: [vendorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy   User           @relation("ExpenseRecorder", fields: [recordedById, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, expenseNo])
  @@index([projectId, expenseDate])
  @@index([organizationId, status, expenseDate])
  @@map("expenses")
}

model Receipt {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  projectId       String?               @db.Uuid
  accountId       String                @db.Uuid
  bankAccountId   String?               @db.Uuid
  receiptNo       String
  receiptDate     DateTime              @db.Date
  description     String
  amount          Decimal               @db.Decimal(18, 2)
  status          FinancialRecordStatus @default(DRAFT)
  sourceReference String?
  recordedById    String                @db.Uuid
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account      ChartOfAccount @relation("ReceiptAccount", fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  bankAccount  BankAccount?   @relation(fields: [bankAccountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  recordedBy   User           @relation("ReceiptRecorder", fields: [recordedById, organizationId], references: [id, organizationId], onDelete: Restrict)

  @@unique([organizationId, receiptNo])
  @@index([projectId, receiptDate])
  @@index([organizationId, status, receiptDate])
  @@map("receipts")
}

model ProjectBudget {
  id              String                @id @default(uuid()) @db.Uuid
  organizationId  String                @db.Uuid
  projectId       String                @db.Uuid
  financialYearId String?               @db.Uuid
  budgetNo        String
  name            String
  totalAmount     Decimal               @default(0) @db.Decimal(18, 2)
  status          FinancialRecordStatus @default(DRAFT)
  approvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project       Project             @relation(fields: [projectId, organizationId], references: [id, organizationId], onDelete: Restrict)
  financialYear FinancialYear?      @relation(fields: [financialYearId, organizationId], references: [id, organizationId], onDelete: Restrict)
  lines         ProjectBudgetLine[]

  @@unique([organizationId, budgetNo])
  @@unique([id, organizationId])
  @@index([projectId, status])
  @@map("project_budgets")
}

model ProjectBudgetLine {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  budgetId       String   @db.Uuid
  accountId      String   @db.Uuid
  budgetAmount   Decimal  @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  budget       ProjectBudget  @relation(fields: [budgetId, organizationId], references: [id, organizationId], onDelete: Restrict)
  account      ChartOfAccount @relation(fields: [accountId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization   @relation(fields: [organizationId], references: [id])

  @@unique([budgetId, accountId])
  @@index([accountId])
  @@index([organizationId])
  @@map("project_budget_lines")
}

enum ApprovalWorkflowStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ApprovalRequestStatus {
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

enum ApprovalDecision {
  APPROVED
  REJECTED
  RETURNED
  DELEGATED
}

enum ApprovalApproverType {
  USER
  ROLE
  DEPARTMENT
}

enum NotificationType {
  APPROVAL_REQUEST
  APPROVAL_APPROVED
  APPROVAL_REJECTED
  APPROVAL_RETURNED
  PAYMENT
  BOOKING
  INSTALLMENT
  PROCUREMENT
  PAYROLL
  SYSTEM
}

enum NotificationStatus {
  UNREAD
  READ
  ARCHIVED
}

model ApprovalWorkflow {
  id             String                 @id @default(uuid()) @db.Uuid
  organizationId String                 @db.Uuid
  workflowKey    String
  name           String
  nameBn         String?
  moduleKey      String
  description    String?
  status         ApprovalWorkflowStatus @default(ACTIVE)
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  steps        ApprovalStep[]
  requests     ApprovalRequest[]

  @@unique([organizationId, workflowKey])
  @@unique([id, organizationId])
  @@index([organizationId, moduleKey, status])
  @@map("approval_workflows")
}

model ApprovalStep {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @db.Uuid
  workflowId        String               @db.Uuid
  stepOrder         Int
  name              String
  nameBn            String?
  approverType      ApprovalApproverType
  approverUserId    String?              @db.Uuid
  approverRoleCode  String?
  departmentCode    String?
  isRequired        Boolean              @default(true)
  allowSelfApproval Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  workflow     ApprovalWorkflow @relation(fields: [workflowId, organizationId], references: [id, organizationId], onDelete: Restrict)
  approverUser User?            @relation("ApprovalStepAssignee", fields: [approverUserId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actions      ApprovalAction[]
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([workflowId, stepOrder])
  @@unique([id, workflowId, organizationId])
  @@index([approverUserId])
  @@index([organizationId])
  @@map("approval_steps")
}

model ApprovalRequest {
  id             String                @id @default(uuid()) @db.Uuid
  organizationId String                @db.Uuid
  workflowId     String                @db.Uuid
  requesterId    String                @db.Uuid
  requestNo      String
  entityType     String
  entityId       String                @db.Uuid
  subject        String
  description    String?
  currentStep    Int                   @default(1)
  status         ApprovalRequestStatus @default(PENDING)
  submittedAt    DateTime              @default(now())
  completedAt    DateTime?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  organization  Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflow      ApprovalWorkflow @relation(fields: [workflowId, organizationId], references: [id, organizationId], onDelete: Restrict)
  requester     User             @relation("ApprovalRequester", fields: [requesterId, organizationId], references: [id, organizationId], onDelete: Restrict)
  actions       ApprovalAction[]
  notifications Notification[]

  @@unique([organizationId, requestNo])
  @@unique([id, organizationId])
  @@unique([id, workflowId, organizationId])
  @@index([organizationId, status, submittedAt])
  @@index([entityType, entityId])
  @@index([workflowId, status])
  @@index([requesterId, submittedAt])
  @@map("approval_requests")
}

model ApprovalAction {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  requestId      String           @db.Uuid
  workflowId     String           @db.Uuid
  stepId         String           @db.Uuid
  actorId        String           @db.Uuid
  decision       ApprovalDecision
  comments       String?
  delegatedToId  String?          @db.Uuid
  actionAt       DateTime         @default(now())
  createdAt      DateTime         @default(now())

  request      ApprovalRequest @relation(fields: [requestId, workflowId, organizationId], references: [id, workflowId, organizationId], onDelete: Restrict)
  step         ApprovalStep    @relation(fields: [stepId, workflowId, organizationId], references: [id, workflowId, organizationId], onDelete: Restrict)
  actor        User            @relation("ApprovalActionActor", fields: [actorId, organizationId], references: [id, organizationId], onDelete: Restrict)
  delegatedTo  User?           @relation("ApprovalActionDelegate", fields: [delegatedToId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([requestId, actionAt])
  @@index([stepId, actionAt])
  @@index([actorId, actionAt])
  @@index([organizationId])
  @@map("approval_actions")
}

model Notification {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  userId            String             @db.Uuid
  approvalRequestId String?            @db.Uuid
  type              NotificationType
  title             String
  titleBn           String?
  message           String
  messageBn         String?
  status            NotificationStatus @default(UNREAD)
  readAt            DateTime?
  createdAt         DateTime           @default(now())

  user            User             @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  approvalRequest ApprovalRequest? @relation(fields: [approvalRequestId, organizationId], references: [id, organizationId], onDelete: Restrict)
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@index([userId, status, createdAt])
  @@index([approvalRequestId])
  @@index([organizationId])
  @@map("notifications")
}

model NotificationPreference {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @db.Uuid
  userId             String   @unique @db.Uuid
  inAppEnabled       Boolean  @default(true)
  emailEnabled       Boolean  @default(false)
  approvalEnabled    Boolean  @default(true)
  paymentEnabled     Boolean  @default(true)
  projectEnabled     Boolean  @default(true)
  procurementEnabled Boolean  @default(true)
  payrollEnabled     Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([userId, organizationId])
  @@index([organizationId])
  @@map("notification_preferences")
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
  DELETED
}

enum StorageProvider {
  FILESYSTEM
  S3_COMPATIBLE
  SUPABASE
  AZURE_BLOB
}

model OrganizationSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  settingKey     String
  value          Json
  description    String?
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, settingKey])
  @@index([organizationId])
  @@map("organization_settings")
}

model ModuleSetting {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  moduleKey      String
  settingKey     String
  value          Json
  description    String?
  isEnabled      Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, moduleKey, settingKey])
  @@index([organizationId, moduleKey, isEnabled])
  @@map("module_settings")
}

model SequenceCounter {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  moduleKey      String
  sequenceKey    String
  fiscalYear     String   @default("GENERAL")
  prefix         String?
  currentValue   BigInt   @default(0)
  paddingLength  Int      @default(5)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, moduleKey, sequenceKey, fiscalYear])
  @@index([organizationId, moduleKey])
  @@map("sequence_counters")
}

model DocumentFolder {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  parentFolderId String?  @db.Uuid
  name           String
  nameBn         String?
  description    String?
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parentFolder DocumentFolder?  @relation("DocumentFolderTree", fields: [parentFolderId], references: [id], onDelete: Restrict)
  childFolders DocumentFolder[] @relation("DocumentFolderTree")
  createdBy    User             @relation("DocumentFolderCreator", fields: [createdById], references: [id], onDelete: Restrict)
  documents    Document[]

  @@unique([organizationId, parentFolderId, name])
  @@index([organizationId, parentFolderId])
  @@map("document_folders")
}

model Document {
  id              String          @id @default(uuid()) @db.Uuid
  organizationId  String          @db.Uuid
  folderId        String?         @db.Uuid
  documentNo      String?
  title           String
  titleBn         String?
  description     String?
  fileName        String
  mimeType        String
  fileSize        BigInt
  storageProvider StorageProvider
  storageKey      String
  checksum        String?
  status          DocumentStatus  @default(ACTIVE)
  isConfidential  Boolean         @default(false)
  createdById     String          @db.Uuid
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  folder       DocumentFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  createdBy    User              @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  versions     DocumentVersion[]
  attachments  FileAttachment[]

  @@unique([organizationId, documentNo])
  @@unique([storageProvider, storageKey])
  @@index([organizationId, status, createdAt])
  @@index([folderId])
  @@map("documents")
}

model DocumentVersion {
  id              String          @id @default(uuid()) @db.Uuid
  documentId      String          @db.Uuid
  versionNo       Int
  fileName        String
  mimeType        String
  fileSize        BigInt
  storageProvider StorageProvider
  storageKey      String
  checksum        String?
  changeNote      String?
  uploadedById    String          @db.Uuid
  createdAt       DateTime        @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Restrict)
  uploadedBy User     @relation("DocumentVersionUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@unique([documentId, versionNo])
  @@unique([storageProvider, storageKey])
  @@index([uploadedById, createdAt])
  @@map("document_versions")
}

model FileAttachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  documentId     String   @db.Uuid
  entityType     String
  entityId       String   @db.Uuid
  attachmentName String?
  createdById    String   @db.Uuid
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  document     Document     @relation(fields: [documentId], references: [id], onDelete: Restrict)
  createdBy    User         @relation("FileAttachmentCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@unique([documentId, entityType, entityId])
  @@index([organizationId, entityType, entityId])
  @@index([documentId])
  @@map("file_attachments")
}
