generator client {
  provider   = "prisma-client"
  output     = "../src/generated/prisma"
  engineType = "client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum FinancialYearStatus {
  OPEN
  CLOSED
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum LandParcelStatus {
  AVAILABLE
  UNDER_NEGOTIATION
  ACQUIRED
  ALLOCATED
  DISPUTED
}

enum LandAcquisitionType {
  PURCHASE
  JOINT_VENTURE
}

enum LandAcquisitionStatus {
  DRAFT
  NEGOTIATION
  AGREEMENT
  REGISTERED
  CANCELLED
}

enum JointVentureStatus {
  DRAFT
  ACTIVE
  COMPLETED
  TERMINATED
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  nameBn    String?
  code      String   @unique
  currency  String   @default("BDT")
  timezone  String   @default("Asia/Dhaka")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branches         Branch[]
  departments      Department[]
  projects         Project[]
  financialYears   FinancialYear[]
  users            User[]
  roles            Role[]
  landParcels      LandParcel[]
  landAcquisitions LandAcquisition[]
  jointVentures    JointVenture[]
  customers        Customer[]
  leads            Lead[]
  salesTeams       SalesTeam[]
  salesAgents      SalesAgent[]
  properties       Property[]
  salesQuotations  SalesQuotation[]
  bookings         Booking[]
  payments         Payment[]

  vendors             Vendor[]
  materialCategories  MaterialCategory[]
  inventoryItems      InventoryItem[]
  warehouses          Warehouse[]
  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]

  employees        Employee[]
  leaveTypes       LeaveType[]
  leaveRequests    LeaveRequest[]
  salaryStructures SalaryStructure[]
  payrolls         Payroll[]
  salaryPayments   SalaryPayment[]

  investors             Investor[]
  investments           Investment[]
  investorContributions InvestorContribution[]
  profitDistributions   ProfitDistribution[]
  investorWithdrawals   InvestorWithdrawal[]
  investmentAgreements  InvestmentAgreement[]

  chartOfAccounts     ChartOfAccount[]
  accountingPeriods   AccountingPeriod[]
  journalEntries      JournalEntry[]
  costCenters         CostCenter[]
  bankAccounts        BankAccount[]
  bankReconciliations BankReconciliation[]
  bankTransactions    BankTransaction[]
  expenses            Expense[]
  receipts            Receipt[]
  projectBudgets      ProjectBudget[]
  projectBudgetLines  ProjectBudgetLine[]

  approvalWorkflows       ApprovalWorkflow[]
  approvalRequests        ApprovalRequest[]
  notificationPreferences NotificationPreference[]
  notifications           Notification[]
  approvalActions         ApprovalAction[]
  approvalSteps           ApprovalStep[]

  organizationSettings OrganizationSetting[]
  moduleSettings       ModuleSetting[]
  sequenceCounters     SequenceCounter[]
  documentFolders      DocumentFolder[]
  documents            Document[]
  fileAttachments      FileAttachment[]

  @@map("organizations")
}

model Branch {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  address        String?
  phone          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]

  employees Employee[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  users        User[]

  employees Employee[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String     @id @default(uuid()) @db.Uuid
  organizationId String     @db.Uuid
  branchId       String?    @db.Uuid
  departmentId   String?    @db.Uuid
  fullName       String
  fullNameBn     String?
  email          String
  phone          String?
  passwordHash   String
  status         UserStatus @default(ACTIVE)
  isSuperAdmin   Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  branch       Branch?      @relation(fields: [branchId, organizationId], references: [id, organizationId], onDelete: Restrict)
  department   Department?  @relation(fields: [departmentId, organizationId], references: [id, organizationId], onDelete: Restrict)
  userRoles    UserRole[]
  auditLogs    AuditLog[]

  taskAssignments      TaskAssignment[]
  dailyProgressReports DailyProgressReport[] @relation("DailyReportSubmitter")
  siteInspections      SiteInspection[]      @relation("SiteInspectionInspector")
  reportedSiteIssues   SiteIssue[]           @relation("SiteIssueReporter")

  requestedProcurements   ProcurementRequest[] @relation("ProcurementRequester")
  createdPurchaseOrders   PurchaseOrder[]      @relation("PurchaseOrderCreator")
  receivedGoodsReceipts   GoodsReceipt[]       @relation("GoodsReceiptReceiver")
  recordedStockMovements  StockMovement[]      @relation("StockMovementRecorder")
  createdStockAdjustments StockAdjustment[]    @relation("StockAdjustmentCreator")

  employee               Employee?       @relation("UserEmployee")
  reviewedLeaveRequests  LeaveRequest[]  @relation("LeaveReviewer")
  recordedSalaryPayments SalaryPayment[] @relation("SalaryPaymentRecorder")

  recordedInvestorContributions InvestorContribution[] @relation("InvestorContributionRecorder")
  recordedProfitDistributions   ProfitDistribution[]   @relation("ProfitDistributionRecorder")
  recordedInvestorWithdrawals   InvestorWithdrawal[]   @relation("InvestorWithdrawalRecorder")

  createdJournalEntries  JournalEntry[]       @relation("JournalCreator")
  approvedJournalEntries JournalEntry[]       @relation("JournalApprover")
  recordedExpenses       Expense[]            @relation("ExpenseRecorder")
  recordedReceipts       Receipt[]            @relation("ReceiptRecorder")
  bankReconciliations    BankReconciliation[] @relation("BankReconciliationRecorder")

  assignedApprovalSteps    ApprovalStep[]          @relation("ApprovalStepAssignee")
  approvalRequestsCreated  ApprovalRequest[]       @relation("ApprovalRequester")
  approvalActions          ApprovalAction[]        @relation("ApprovalActionActor")
  delegatedApprovalActions ApprovalAction[]        @relation("ApprovalActionDelegate")
  notifications            Notification[]
  notificationPreference   NotificationPreference?

  createdDocumentFolders   DocumentFolder[]  @relation("DocumentFolderCreator")
  createdDocuments         Document[]        @relation("DocumentCreator")
  uploadedDocumentVersions DocumentVersion[] @relation("DocumentVersionUploader")
  createdFileAttachments   FileAttachment[]  @relation("FileAttachmentCreator")

  @@unique([organizationId, email])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([branchId])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  nameBn         String?
  code           String
  description    String?
  isSystem       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userRoles    UserRole[]
  permissions  RolePermission[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@index([module])
  @@map("permissions")
}

model UserRole {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  roleId         String   @db.Uuid
  assignedAt     DateTime @default(now())

  user User @relation(fields: [userId, organizationId], references: [id, organizationId], onDelete: Cascade)
  role Role @relation(fields: [roleId, organizationId], references: [id, organizationId], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String @id @default(uuid()) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Project {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @db.Uuid
  name           String
  nameBn         String?
  code           String
  description    String?
  address        String?
  status         ProjectStatus @default(PLANNING)
  startDate      DateTime?     @db.Date
  endDate        DateTime?     @db.Date
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  landParcels     LandParcel[]
  acquisitions    LandAcquisition[]
  jointVentures   JointVenture[]
  leads           Lead[]
  properties      Property[]
  salesQuotations SalesQuotation[]
  bookings        Booking[]

  constructionPhases    ConstructionPhase[]
  workPackages          WorkPackage[]
  constructionTasks     ConstructionTask[]
  dailyProgressReports  DailyProgressReport[]
  siteInspections       SiteInspection[]
  siteIssues            SiteIssue[]
  constructionDocuments ConstructionDocument[]

  procurementRequests ProcurementRequest[]
  purchaseOrders      PurchaseOrder[]
  warehouses          Warehouse[]

  payrollItems PayrollItem[]

  investments           Investment[]
  investorContributions InvestorContribution[]
  profitDistributions   ProfitDistribution[]
  investorWithdrawals   InvestorWithdrawal[]
  investmentAgreements  InvestmentAgreement[]

  costCenters    CostCenter[]
  journalLines   JournalLine[]
  expenses       Expense[]
  receipts       Receipt[]
  projectBudgets ProjectBudget[]

  @@unique([organizationId, code])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("projects")
}

model LandParcel {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @db.Uuid
  projectId      String?          @db.Uuid
  parcelCode     String
  district       String
  upazila        String?
  mouza          String?
  jlNumber       String?
  khatianNumber  String?
  dagNumber      String?
  area           Decimal          @db.Decimal(18, 4)
  areaUnit       String           @default("DECIMAL")
  address        String?
  status         LandParcelStatus @default(AVAILABLE)
  notes          String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  acquisitions LandAcquisitionParcel[]

  @@unique([organizationId, parcelCode])
  @@index([organizationId, status])
  @@index([projectId])
  @@index([district, upazila, mouza])
  @@map("land_parcels")
}

model LandAcquisition {
  id               String                @id @default(uuid()) @db.Uuid
  organizationId   String                @db.Uuid
  projectId        String                @db.Uuid
  referenceNo      String
  acquisitionType  LandAcquisitionType
  status           LandAcquisitionStatus @default(DRAFT)
  agreementDate    DateTime?             @db.Date
  registrationDate DateTime?             @db.Date
  totalValue       Decimal               @default(0) @db.Decimal(18, 2)
  currency         String                @default("BDT")
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  parcels      LandAcquisitionParcel[]

  @@unique([organizationId, referenceNo])
  @@index([projectId, status])
  @@index([organizationId, acquisitionType])
  @@map("land_acquisitions")
}

model LandAcquisitionParcel {
  id                String   @id @default(uuid()) @db.Uuid
  landAcquisitionId String   @db.Uuid
  landParcelId      String   @db.Uuid
  agreedValue       Decimal? @db.Decimal(18, 2)
  createdAt         DateTime @default(now())

  acquisition LandAcquisition @relation(fields: [landAcquisitionId], references: [id], onDelete: Cascade)
  parcel      LandParcel      @relation(fields: [landParcelId], references: [id], onDelete: Restrict)

  @@unique([landAcquisitionId, landParcelId])
  @@index([landParcelId])
  @@map("land_acquisition_parcels")
}

model JointVenture {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  projectId      String             @db.Uuid
  referenceNo    String
  agreementDate  DateTime?          @db.Date
  status         JointVentureStatus @default(DRAFT)
  companyShare   Decimal?           @db.Decimal(7, 4)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project               @relation(fields: [projectId], references: [id], onDelete: Restrict)
  partners     JointVenturePartner[]

  @@unique([organizationId, referenceNo])
  @@index([projectId, status])
  @@map("joint_ventures")
}

model JointVenturePartner {
  id               String   @id @default(uuid()) @db.Uuid
  jointVentureId   String   @db.Uuid
  partnerName      String
  partnerNameBn    String?
  phone            String?
  address          String?
  sharePercentage  Decimal  @db.Decimal(7, 4)
  landContribution Decimal? @db.Decimal(18, 4)
  cashContribution Decimal? @db.Decimal(18, 2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  jointVenture JointVenture @relation(fields: [jointVentureId], references: [id], onDelete: Cascade)

  @@index([jointVentureId])
  @@map("joint_venture_partners")
}

model FinancialYear {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @db.Uuid
  name           String
  startDate      DateTime            @db.Date
  endDate        DateTime            @db.Date
  status         FinancialYearStatus @default(OPEN)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  accountingPeriods AccountingPeriod[]
  projectBudgets    ProjectBudget[]

  @@unique([organizationId, name])
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@map("financial_years")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  action    String
  entity    String
  entityId  String?
  projectId String?  @db.Uuid
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([projectId, createdAt])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CONVERTED
  LOST
}

enum LeadSource {
  WALK_IN
  PHONE
  WEBSITE
  FACEBOOK
  REFERRAL
  OTHER
}

enum LeadActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
  WHATSAPP
  SITE_VISIT
}

enum PropertyType {
  FLAT
  PLOT
  SHOP
  PARKING
  OFFICE
}

enum PropertyStatus {
  DRAFT
  AVAILABLE
  RESERVED
  BOOKED
  SOLD
  BLOCKED
  UNDER_CONSTRUCTION
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED
}

enum BookingStatus {
  DRAFT
  PENDING_APPROVAL
  CONFIRMED
  CANCELLED
  COMPLETED
  DEFAULTED
}

enum InstallmentFrequency {
  MONTHLY
  QUARTERLY
  HALF_YEARLY
  YEARLY
  CUSTOM
}

enum InstallmentStatus {
  PENDING
  PARTIAL
  PAID
  OVERDUE
  WAIVED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  MOBILE_BANKING
  CARD
  OTHER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REVERSED
}

enum AgreementStatus {
  DRAFT
  PENDING_SIGNATURE
  SIGNED
  CANCELLED
}

model Customer {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @db.Uuid
  customerCode   String
  type           CustomerType @default(INDIVIDUAL)
  fullName       String
  fullNameBn     String?
  companyName    String?
  email          String?
  phone          String
  alternatePhone String?
  nationalId     String?
  passportNo     String?
  dateOfBirth    DateTime?    @db.Date
  notes          String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  addresses      CustomerAddress[]
  convertedLeads Lead[]            @relation("ConvertedLeadCustomer")
  quotations     SalesQuotation[]
  bookings       Booking[]
  payments       Payment[]

  @@unique([organizationId, customerCode])
  @@index([organizationId, phone])
  @@index([organizationId, email])
  @@index([organizationId, fullName])
  @@map("customers")
}

model CustomerAddress {
  id          String   @id @default(uuid()) @db.Uuid
  customerId  String   @db.Uuid
  label       String?
  addressLine String
  district    String?
  upazila     String?
  postalCode  String?
  country     String   @default("Bangladesh")
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@map("customer_addresses")
}

model SalesTeam {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  name           String
  code           String
  description    String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agents       SalesAgent[]

  @@unique([organizationId, code])
  @@index([organizationId, isActive])
  @@map("sales_teams")
}

model SalesAgent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  teamId         String?  @db.Uuid
  agentCode      String
  fullName       String
  phone          String?
  email          String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  team         SalesTeam?   @relation(fields: [teamId], references: [id], onDelete: SetNull)
  leads        Lead[]

  @@unique([organizationId, agentCode])
  @@index([teamId])
  @@map("sales_agents")
}

model Lead {
  id                  String        @id @default(uuid()) @db.Uuid
  organizationId      String        @db.Uuid
  projectId           String?       @db.Uuid
  assignedAgentId     String?       @db.Uuid
  convertedCustomerId String?       @db.Uuid
  leadNo              String
  fullName            String
  phone               String
  email               String?
  source              LeadSource    @default(OTHER)
  status              LeadStatus    @default(NEW)
  interestedType      PropertyType?
  budgetMin           Decimal?      @db.Decimal(18, 2)
  budgetMax           Decimal?      @db.Decimal(18, 2)
  notes               String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project      Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  agent        SalesAgent?    @relation(fields: [assignedAgentId], references: [id], onDelete: SetNull)
  customer     Customer?      @relation("ConvertedLeadCustomer", fields: [convertedCustomerId], references: [id], onDelete: SetNull)
  activities   LeadActivity[]

  @@unique([organizationId, leadNo])
  @@index([organizationId, status, createdAt])
  @@index([assignedAgentId, status])
  @@index([phone])
  @@map("leads")
}

model LeadActivity {
  id           String           @id @default(uuid()) @db.Uuid
  leadId       String           @db.Uuid
  activityType LeadActivityType
  subject      String?
  description  String?
  scheduledAt  DateTime?
  completedAt  DateTime?
  createdAt    DateTime         @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@map("lead_activities")
}

model Property {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @db.Uuid
  projectId      String         @db.Uuid
  propertyCode   String
  type           PropertyType
  status         PropertyStatus @default(DRAFT)
  buildingName   String?
  floor          String?
  unitNo         String?
  bedrooms       Int?
  bathrooms      Int?
  area           Decimal        @db.Decimal(18, 4)
  areaUnit       String         @default("SQ_FT")
  facing         String?
  description    String?
  basePrice      Decimal        @db.Decimal(18, 2)
  currency       String         @default("BDT")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  project        Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  prices         PropertyPrice[]
  quotationItems SalesQuotationItem[]
  bookings       Booking[]

  constructionDocuments ConstructionDocument[]

  @@unique([organizationId, propertyCode])
  @@unique([id, projectId])
  @@index([projectId, type, status])
  @@index([organizationId, status])
  @@map("properties")
}

model PropertyPrice {
  id            String    @id @default(uuid()) @db.Uuid
  propertyId    String    @db.Uuid
  price         Decimal   @db.Decimal(18, 2)
  effectiveFrom DateTime  @db.Date
  effectiveTo   DateTime? @db.Date
  reason        String?
  createdAt     DateTime  @default(now())

  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId, effectiveFrom])
  @@map("property_prices")
}

model SalesQuotation {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  customerId     String          @db.Uuid
  projectId      String?         @db.Uuid
  quotationNo    String
  status         QuotationStatus @default(DRAFT)
  issueDate      DateTime        @db.Date
  validUntil     DateTime?       @db.Date
  subtotal       Decimal         @default(0) @db.Decimal(18, 2)
  discountAmount Decimal         @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal         @default(0) @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customer     Customer             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  project      Project?             @relation(fields: [projectId], references: [id], onDelete: SetNull)
  items        SalesQuotationItem[]
  booking      Booking?

  @@unique([organizationId, quotationNo])
  @@index([customerId, status])
  @@index([projectId, issueDate])
  @@map("sales_quotations")
}

model SalesQuotationItem {
  id             String   @id @default(uuid()) @db.Uuid
  quotationId    String   @db.Uuid
  propertyId     String   @db.Uuid
  unitPrice      Decimal  @db.Decimal(18, 2)
  discountAmount Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount    Decimal  @db.Decimal(18, 2)
  notes          String?
  createdAt      DateTime @default(now())

  quotation SalesQuotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  property  Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  @@index([quotationId])
  @@index([propertyId])
  @@map("sales_quotation_items")
}

model Booking {
  id                String        @id @default(uuid()) @db.Uuid
  organizationId    String        @db.Uuid
  projectId         String        @db.Uuid
